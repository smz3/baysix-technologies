{
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "TodoWrite",
      "Bash(*)",
      "mcp__*",
      "Bash(powershell.exe -Command:*)",
      "Bash(powershell -Command Start-Process*)",
      "Bash(powershell.exe -Command Start-Process*)"
    ],
    "deny": [
      "Bash(curl * api.binance.com/api/v3/order*)",
      "Bash(curl * -X POST * /order*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git reset --hard*)",
      "Bash(git merge*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Deleting untracked, regenerable artifacts INSIDE the baysix-technologies repo is allowed without further confirmation: __pycache__/ and .pytest_cache/ directories, *.log files under research/models/_archive/, research/data/parquet/, and empty directories. These are gitignored build/run byproducts with zero git impact.",
      "Removing an empty directory inside the repo with rmdir is allowed."
    ],
    "soft_deny": [
      "$defaults",
      "Deleting anything under research/db/ (including research.db, execution.db, and every file in research/db/_backup/) is NEVER allowed — these are the live research ledger and its only snapshots.",
      "Deleting anything under research/data/arctic/ is NEVER allowed — canonical tick data.",
      "Deleting git-TRACKED files is not allowed here; those go through git rm in an agent_commit.py pass, not a bare rm."
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "SIGMA_BRAIN": "C:\\Users\\User\\Desktop\\baysix-technologies",
    "SIGMA_QUANT": "C:\\Users\\User\\Desktop\\sigma-quant",
    "SIGMA_LINKEDIN": "C:\\Users\\User\\Desktop\\sigma-linkedin",
    "SIGMA_RESEARCH": "C:\\Users\\User\\Desktop\\sigma-research"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/archive_handovers.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/prune_handover_archive.py\" --days 2 --apply",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/session_brief.py\"",
            "timeout": 15,
            "statusMessage": "session brief"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__playwright__browser_navigate",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/playwright_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/protocol_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/claim_lint.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/edit_watcher.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/context_watch.py\"",
            "timeout": 5,
            "statusMessage": "context-watch"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5,
            "async": true,
            "statusMessage": "Stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/claim_lint.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5,
            "async": true,
            "statusMessage": "StopFailure"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5,
            "async": true,
            "statusMessage": "TaskCompleted"
          }
        ]
      }
    ]
  }
}
