{
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "TodoWrite",
      "Bash(*)",
      "mcp__*"
    ],
    "deny": [
      "Bash(curl * api.binance.com/api/v3/order*)",
      "Bash(curl * -X POST * /order*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git merge*)"
    ]
  },
  "enabledMcpjsonServers": ["context7", "supabase", "playwright"],
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "SIGMA_BRAIN": "C:\\Users\\User\\Desktop\\sigma-brain",
    "SIGMA_WORKSPACE": "C:\\Users\\User\\Desktop\\sigma-brain\\workspace",
    "SIGMA_CRYPTO": "C:\\Users\\User\\Desktop\\sigma-crypto",
    "SIGMA_MT5": "C:\\Users\\User\\Desktop\\sigma-mt5",
    "SIGMA_QUANT": "C:\\Users\\User\\Desktop\\sigma-quant",
    "SIGMA_LINKEDIN": "C:\\Users\\User\\Desktop\\sigma-linkedin",
    "SIGMA_RESEARCH": "C:\\Users\\User\\Desktop\\sigma-research"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== SIGMA-BRAIN SESSION START ===' && echo '' && echo '--- Strategy State ---' && cat Memory/strategy_state.md 2>/dev/null || echo '(no strategy_state.md yet)' && echo '' && echo '--- Risk Parameters ---' && cat Memory/risk_parameters.md 2>/dev/null || echo '(no risk_parameters.md yet)' && echo '' && echo '--- Research Queue ---' && cat Memory/research_queue.md 2>/dev/null || echo '(no research_queue.md yet)'",
            "timeout": 5000,
            "once": true
          },
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "async": true,
            "once": true,
            "statusMessage": "SessionStart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "async": true,
            "once": true,
            "statusMessage": "SessionEnd"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "async": true,
            "statusMessage": "PreToolUse"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_navigate",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/playwright_guard.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "async": true,
            "statusMessage": "PostToolUse"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/edit_watcher.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "async": true,
            "statusMessage": "PostToolUseFailure"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "async": true,
            "statusMessage": "PermissionRequest"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "async": true,
            "statusMessage": "PermissionDenied"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
