# Baysix AI Hedge Fund — Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit the actual .env file to version control.

# === LLM Providers ===
GROQ_API_KEY="your_groq_api_key_here"       # Free: https://console.groq.com
GEMINI_API_KEY="your_gemini_api_key_here"   # Free: https://aistudio.google.com

# === Data Providers ===
FRED_API_KEY="your_fred_api_key_here"       # Free: https://fred.stlouisfed.org/docs/api/

# === Supabase (reuse sigma-quant project) ===
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# === Local Infrastructure (default values, usually no change needed) ===
OLLAMA_URL="http://localhost:11434"
QDRANT_URL="http://localhost:6333"
