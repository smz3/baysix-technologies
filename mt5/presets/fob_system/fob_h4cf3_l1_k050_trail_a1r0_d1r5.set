; ==========================================================================
; FOB-001 - H4/CF3 TRAIL re-run under v1.41.0 trail semantics (task 267)
;
; This is result_id 39's config, verbatim. The ONLY thing that changed is the
; EA: v1.41.0 floors the trailed SL at entry, so an armed trail can no longer
; book a loss. Inputs are UNCHANGED (1.0 / 1.5) precisely so the delta vs
; result_id 39 isolates the trail-semantics fix and nothing else.
;
; result_id 39 (v1.38.0, broken trail, git 43a57be):
;   +$1.001/tr  n=373  meanR +0.083  medR -0.95  maxR 11.24  WR 34.0%
;
; Tester: Model=4 (real ticks), XAUUSD_dukas, IS window 2016-06-01 -> 2024-06-28.
; The OOS block (2024-07-01 ->) is SEALED. Do not run it from this preset.
; ==========================================================================

; ---- MODE -----------------------------------------------------------------
InpMode=1
; 0=FOB_EMIT | 1=FOB_TRADE | 2=FOB_STUDY

; ---- setup pair -----------------------------------------------------------
InpTfPair=4
; 0=M5_M1 1=M15_M5 2=M30_M15 3=H1_M30 4=H4_H1 5=D1_H4
InpCfIdxFilter=3
; 3 = the CF3 sweet spot (hump-shaped: CF3 peak, CF4+ exhaustion)

; ---- filters: all OFF (this is the noSession leg) --------------------------
InpDirFilterTf=-1
; -1=NONE 6=D1 7=W1 8=MN1
InpSessionFilter=false
InpSessionStartHr=12
InpSessionEndHr=23

; ---- orders ---------------------------------------------------------------
InpSlBufferK=0.5
; SL = beyond zone L2 by k*band, band=|L1-L2|
InpRMultTP=2.0
; INERT under InpTrailStop=true (trail disables the fixed TP)
InpFixedLot=0.01
InpMagic=3001

; ---- direction ------------------------------------------------------------
InpInvertDir=false
; false = NORMAL (continuation). Inversion FALSIFIED at M30-M15 (result_id 54).

; ---- structural exits: OFF ------------------------------------------------
InpExitOnCfInval=false
InpExitOnOppPbo=false

; ---- trailing stop: ON (sole profit exit) ---------------------------------
InpTrailStop=true
InpTrailActivateR=1.0
InpTrailDistR=1.5
; v1.41.0: dist > activate is now SAFE -- cand is floored at entry, so the
; trail locks breakeven at +1.0R and true profit above +1.5R. Under v1.38.0
; this pair placed the stop at entry - 0.5R and locked nothing.

; ---- entry mechanic -------------------------------------------------------
InpEntryMode=1
; 0=CF_MARKET 1=CF_L1_LIMIT 2=PBO_LIMIT   ('l1' in the result_id 39 metric key)
InpPboEntryLevel=0
; inert under CF_L1_LIMIT

; ---- STUDY-only (inert in TRADE) ------------------------------------------
InpStudyCapBars=48

; ---- LIVE-chart only (ignored in the tester) ------------------------------
InpVisualize=false
InpTickWarmDays=30
InpDebugRt=false
