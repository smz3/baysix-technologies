; ==========================================================================
; FOB-001 - direction A/B, ARM B (INVERTED / mirror fade)
; Setup M30 -> CF on M15 | ALL CFs | no filters | trail-only exit
;
; IDENTICAL to fob_m30m15_cfALL_trail_k050_A_baseline.set except InpInvertDir.
; Diff the two files: exactly one value line must change. If anything else
; differs, the A/B is contaminated and the result must be discarded.
;
; EA: fob_baysix v1.40.0, git 46216a0 (CLEAN — init line must print no -DIRTY)
; Tester: Model=4 (every tick based on real ticks), XAUUSD_dukas, UTC offset set,
;         IS window 2016.06.01 -> 2024.06.30. The 2024.07.01 -> 2026.05.01 block
;         stays SEALED for the winning arm.
; Init line must read:  DIR=INVERTED(mirror-fade)
; Ledger lands as ..._cf_inv_k050_...  (arm A is ..._cf_nrm_k050_...)
; ==========================================================================

; ---- MODE -----------------------------------------------------------------
InpMode=1
; 0=FOB_EMIT (oracle CSV, no orders) | 1=FOB_TRADE | 2=FOB_STUDY

; ---- setup pair -----------------------------------------------------------
InpTfPair=2
; 0=M5_M1 1=M15_M5 2=M30_M15 3=H1_M30 4=H4_H1 5=D1_H4
InpCfIdxFilter=0
; 0 = ALL CFs in every cycle (population screen, NOT a deployable config)

; ---- filters: all OFF (clean baseline) ------------------------------------
InpDirFilterTf=-1
; -1=NONE 6=D1 7=W1 8=MN1
InpSessionFilter=false
InpSessionStartHr=12
InpSessionEndHr=23

; ---- orders ---------------------------------------------------------------
InpSlBufferK=0.5
; SL = beyond zone L2 by k*band, band=|L1-L2|
InpRMultTP=1.0
; INERT under InpTrailStop=true (trail disables the fixed TP)
InpFixedLot=0.01
InpMagic=3001

; ---- DIRECTION: this is the ONLY line that differs between arm A and arm B ----
InpInvertDir=true
; true = INVERTED (mirror fade, trade AGAINST the CF; stop reflected, |risk| unchanged)

; ---- structural exits: OFF ------------------------------------------------
InpExitOnCfInval=false
InpExitOnOppPbo=false

; ---- trailing stop: ON (sole profit exit) ---------------------------------
InpTrailStop=true
InpTrailActivateR=1.0
InpTrailDistR=1.5

; ---- entry mechanic -------------------------------------------------------
InpEntryMode=0
; 0=CF_MARKET 1=CF_L1_LIMIT 2=PBO_LIMIT
; NOTE: CF_L1_LIMIT / PBO_LIMIT under InpInvertDir=true are near-empty BY
; CONSTRUCTION (the inverted pending sits on the wrong side of price and is
; skipped). The direction A/B must run on CF_MARKET.
InpPboEntryLevel=0
; inert under CF_MARKET

; ---- STUDY-only (inert in TRADE) ------------------------------------------
InpStudyCapBars=48

; ---- LIVE-chart only (ignored in the tester) ------------------------------
InpTickWarmDays=30
InpDebugRt=false
