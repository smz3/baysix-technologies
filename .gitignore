**/dist/
**/build/

# IDE / OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
.obsidian/

# Memory — runtime data, not source of truth
Memory/inbox/
Memory/consolidated/
memory.db
*.sqlite3

