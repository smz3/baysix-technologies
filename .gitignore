*.pem
*.key
*.cert

# Dependencies
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
*$py.class
venv/
.env/
env/
.venv/
**/.venv/
**/node_modules/
**/dist/
**/build/

# IDE / OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
.obsidian/

# Memory / handovers — local AI-context state, kept private (untracked 2026-07-25)
Memory/
memory/
memory.db
*.sqlite3

# Dead legacy research DBs (superseded by research.db via migrations 010/011).
# Migration 011_migrate_data.py re-creates these 0-byte husks if run/imported — ignore so they never reappear in git.
research/db/ideas_log.db
research/db/research_log.db
research/db/agent_log.db

# execution.db = the LIVE downstream DB (real-money fills, account/broker_login state).
# Protocol §1 Isolation: live records stay out of git. Rebuildable anytime via
# `python research/migrations/020_create_execution_db.py`.
research/db/execution.db

# research.db UNTRACKED 2026-07-01 (task 203): hit 675MB after run_id 18 (8yr FOB ingest)
# > GitHub 100MB hard cap. It is DERIVED/rebuildable — rebuild via ingest_fob on the
# emit CSV (Common/Files/FOB/fob_capture_XAUUSD_dukas_*.csv = the source of truth, backed
# up off-disk). Was tracked through HEAD 78d8f12 (88MB); history left intact (all ≤88MB,
# already pushed). Local space reclaim: `git gc --prune=now`.
research/db/research.db

# Pre-rebuild full-DB backups (Protocol 4.0 capture-before-nuke, ~100MB each) — local restore points only.
# The small human-readable BRC seed in research/db/_seed/ IS tracked.
research/db/_backup/

# Stack runtime
.gstack/

# Debug artifacts (browser sessions, screenshots, build logs)
micro-*.png
micro-*.md
.playwright-mcp/
outputs/
pip_*.txt
openbb_build*.log
pip_install.log

# Workspace — all sub-projects have their own git repos; ignore workspace contents entirely.
workspace/*
!workspace/scripts/
!workspace/scripts/**

# Compiled / generated
*.pyc
*.pyo
dist/
build/
*.egg-info/

# Binaries / installers / native artifacts — never belong in the repo
# (guardrail for auto-commit+push: keeps blind `add -A` from committing junk)
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.winmd
*.dll
*.so
*.dylib
*.iso
*.bin

# Logs
*.log
security_alerts.log

# Large data files
*.csv
*.parquet
*.pkl
*.h5
*.zip

# ArcticDB local store (LMDB backend — large binary, never commit)
data/arctic/
*.lmdb

# FOB raw payload (task 229 data-plane split — Parquet-per-run, derivable from emit CSV)
data/fob_payload/

# Secrets scanner output
Sandbox/

# Antigravity brain data
.antigravity/

# Claude Code local artifacts (machine-specific / runtime / temp)
.claude/worktrees/
.claude/hooks/logs/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/agent-memory/
*.bak

# ORB backtest run logs
research/models/orb/_*.log

# Research paper source PDFs — kept local only (copyright + binary bloat).
# The dissection lives in research.db (step2_papers), not the source file.
*.pdf

# Docling-extracted paper source text (research/papers/<family>/<stem>.md) —
# derivable from the PDF via extract_pdf.py, so gitignored. Keep the value-add
# dissection narrative (<stem>.dissect.md) and the folder READMEs tracked.
research/papers/**/*.md
!research/papers/**/*.dissect.md
!research/papers/**/README.md

# Session-temp safety copy from the 4.0 rebuild (migration 032); canonical backup lives in _backup/.
research/db/*.pre40_rebuild

# Auto-generated provenance headers (regenerated each compile via gen_version.py <system>)
mt5/Include/brc_system/brc_version.mqh
mt5/Include/fob_system/fob_version.mqh

# transient tester sentinels
mt5/tester/_*.done
